{
  "manifest_version": 3,
  "name": "XIYUE 浏览器控制",
  "version": "1.0.0",
  "description": "让 XIYUE AI 打开网页、读取内容、点击、填写并截图。",
  "minimum_chrome_version": "110",
  "permissions": ["tabs", "scripting", "activeTab", "windows", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://yocim.top/*",
      "https://*.yocim.top/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "key": ""
}
